{
  "permissions": {
    "deny": [
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git -C * add:*)",
      "Bash(git -C * commit:*)",
      "Bash(git -C * push:*)",
      "Bash(git --git-dir=* add:*)",
      "Bash(git --git-dir=* commit:*)",
      "Bash(git --git-dir=* push:*)"
    ]
  }
}
