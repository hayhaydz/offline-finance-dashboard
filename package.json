{
  "name": "offline-finance-dashboard",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --host 127.0.0.1 --port 5173 --strictPort",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest",
    "test:run": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:reset": "tsx scripts/reset.ts",
    "seed:standard": "tsx scripts/seed.ts --mode=standard",
    "seed:edge": "tsx scripts/seed.ts --mode=edge",
    "seed:stress": "tsx scripts/seed.ts --mode=stress",
    "migrate:slugs": "tsx scripts/migrate-slugs.ts",
    "postinstall": "svelte-kit sync"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "@sveltejs/kit": "^2.17.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@tailwindcss/vite": "^4.1.18",
    "better-sqlite3": "^12.6.2",
    "better-sqlite3-multiple-ciphers": "^12.6.2",
    "bits-ui": "^2.15.5",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.4",
    "drizzle-orm": "^0.45.1",
    "nanoid": "^3.3.11",
    "otplib": "^13.2.1",
    "qrcode": "^1.5.4",
    "svelte": "^5.50.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.18",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^5.5.2",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.0",
    "@types/qrcode": "^1.5.5",
    "drizzle-kit": "^0.30.4",
    "svelte-check": "^4.1.4",
    "tsx": "^4.21.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.0",
    "vitest": "^4.0.18"
  }
}
