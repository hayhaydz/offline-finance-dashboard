{
	"name": "offline-finance-dashboard",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev --host 127.0.0.1 --port 5173 --strictPort",
		"build": "vite build",
		"start": "node --env-file=.env build",
    "preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"lint": "biome check .",
		"lint:fix": "biome check . --write --unsafe",
		"test": "vitest",
		"test:run": "vitest run",
		"db:generate": "drizzle-kit generate",
		"db:studio": "drizzle-kit studio",
		"db:doctor": "tsx scripts/db-doctor.ts",
		"db:plan": "tsx scripts/query-plan.ts",
		"db:reset": "tsx scripts/reset.ts",
		"seed": "tsx scripts/seed.ts --mode=standard",
		"seed:standard": "tsx scripts/seed.ts --mode=standard",
		"seed:edge": "tsx scripts/seed.ts --mode=edge",
		"seed:stress": "tsx scripts/seed.ts --mode=stress",
		"postinstall": "svelte-kit sync"
	},
	"dependencies": {
		"@node-rs/argon2": "^2.0.2",
		"@sveltejs/kit": "^2.17.0",
		"@tailwindcss/postcss": "^4.1.18",
		"@tailwindcss/vite": "^4.1.18",
		"better-sqlite3": "^12.6.2",
		"better-sqlite3-multiple-ciphers": "^12.6.2",
		"bits-ui": "^2.15.5",
		"clsx": "^2.1.1",
		"dotenv": "^17.2.4",
		"drizzle-orm": "^0.45.1",
		"isomorphic-dompurify": "^3.8.0",
		"nanoid": "^3.3.11",
		"otplib": "^13.2.1",
		"qrcode": "^1.5.4",
		"svelte": "^5.50.0",
		"tailwind-merge": "^3.4.0",
		"tailwindcss": "^4.1.18",
		"winston": "^3.19.0",
		"winston-daily-rotate-file": "^5.0.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.4",
		"@sveltejs/adapter-node": "^5.5.2",
		"@sveltejs/vite-plugin-svelte": "^5.0.0",
		"@types/better-sqlite3": "^7.6.12",
		"@types/dompurify": "^3.0.5",
		"@types/node": "^22.19.17",
		"@types/qrcode": "^1.5.5",
		"drizzle-kit": "^0.30.4",
		"svelte-check": "^4.1.4",
		"tsx": "^4.21.0",
		"typescript": "^5.7.3",
		"vite": "^6.0.0",
		"vitest": "^4.0.18"
	}
}
